{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/johnstel/azureeslzmultisubdemo/identity/schema/conditional-access-policy.schema.json",
  "title": "Entra Conditional Access policy input (report-only demo artifact)",
  "description": "Declarative shape for a Microsoft Graph conditionalAccessPolicies resource, restricted to report-only demo usage. This file is validated statically and is never sent to Microsoft Graph by this repository.",
  "type": "object",
  "required": [
    "displayName",
    "state",
    "conditions",
    "grantControls",
    "emergencyAccessExclusion",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "description": "Must remain report-only for this demo. enabledForReportingButNotEnforced never blocks or requires a control.",
      "const": "enabledForReportingButNotEnforced"
    },
    "conditions": {
      "type": "object",
      "required": ["users", "applications", "clientAppTypes"],
      "additionalProperties": true,
      "properties": {
        "users": {
          "type": "object",
          "required": ["includeRoles", "excludeGroups"],
          "properties": {
            "includeRoles": {
              "type": "array",
              "items": { "type": "string" }
            },
            "includeUsers": {
              "type": "array",
              "items": { "type": "string" }
            },
            "excludeGroups": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" },
              "description": "Must contain at least one emergency-access (break-glass) group placeholder. Never leave empty."
            }
          }
        },
        "applications": {
          "type": "object",
          "required": ["includeApplications"],
          "properties": {
            "includeApplications": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        "clientAppTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["all", "browser", "mobileAppsAndDesktopClients", "exchangeActiveSync", "other"]
          }
        }
      }
    },
    "grantControls": {
      "type": "object",
      "required": ["operator", "builtInControls"],
      "properties": {
        "operator": {
          "type": "string",
          "enum": ["OR", "AND"]
        },
        "builtInControls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "block",
              "mfa",
              "authenticationStrength",
              "compliantDevice",
              "domainJoinedDevice",
              "approvedApplication",
              "compliantApplication"
            ]
          }
        },
        "authenticationStrength": {
          "type": "string",
          "description": "Required when builtInControls includes authenticationStrength; must name a phishing-resistant strength for privileged roles."
        }
      }
    },
    "emergencyAccessExclusion": {
      "type": "object",
      "required": ["required", "placeholder", "description"],
      "properties": {
        "required": {
          "type": "boolean",
          "const": true
        },
        "placeholder": {
          "type": "string",
          "pattern": "^REPLACE_WITH_.+$",
          "description": "Object ID of the emergency-access/break-glass group or user. Must be replaced with a real value before any apply workflow runs; the apply workflow must refuse to run while this placeholder remains."
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
